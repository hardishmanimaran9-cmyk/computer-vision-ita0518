

import cv2

from cv_lab_common import read_image, show_images


def crop_copy_paste(image, x=0.1, y=0.1, roi_width=0.35, roi_height=0.35):
    height, width = image.shape[:2]
    left, top = int(width * x), int(height * y)
    right = min(width, left + max(1, int(width * roi_width)))
    bottom = min(height, top + max(1, int(height * roi_height)))
    roi = image[top:bottom, left:right].copy()
    if roi.size == 0:
        raise ValueError("ROI is empty; choose valid normalized ROI coordinates")
    result = image.copy()
    paste_x, paste_y = width - roi.shape[1], height - roi.shape[0]
    result[paste_y:height, paste_x:width] = roi
    cv2.rectangle(result, (left, top), (right - 1, bottom - 1), (0, 255, 0), 2)
    return roi, result


if __name__ == "__main__":
    image = read_image()
    roi, result = crop_copy_paste(image)
    show_images(("Source with copied ROI", result), ("Cropped ROI", roi))
