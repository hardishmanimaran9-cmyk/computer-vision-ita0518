

import cv2

from cv_lab_common import image_path, read_image, show_images


def add_watermark(image, text="CV LAB", opacity=0.35):
    if not 0.0 <= opacity <= 1.0:
        raise ValueError("opacity must be between 0 and 1")
    overlay = image.copy()
    height, width = image.shape[:2]
    font_scale = max(0.5, min(width, height) / 700)
    cv2.putText(overlay, text, (max(10, width // 30), max(30, height - height // 20)),
                cv2.FONT_HERSHEY_SIMPLEX, font_scale, (255, 255, 255), 2, cv2.LINE_AA)
    return cv2.addWeighted(overlay, opacity, image, 1 - opacity, 0)


if __name__ == "__main__":
    original = read_image()
    result = add_watermark(original)
    output_path = image_path("watermarked.jpg")
    if not cv2.imwrite(str(output_path), result):
        raise OSError(f"Could not save watermarked image: {output_path}")
    show_images(("Original", original), ("Watermarked", result))
