

import cv2

from cv_lab_common import read_image, show_images


def sobel_edges(image):
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    horizontal = cv2.Sobel(gray, cv2.CV_64F, 1, 0, ksize=3)
    vertical = cv2.Sobel(gray, cv2.CV_64F, 0, 1, ksize=3)
    combined = cv2.magnitude(horizontal, vertical)
    return cv2.convertScaleAbs(horizontal), cv2.convertScaleAbs(vertical), cv2.convertScaleAbs(combined)


if __name__ == "__main__":
    image = read_image()
    dx, dy, combined = sobel_edges(image)
    show_images(("Original", image), ("Sobel X", dx), ("Sobel Y", dy), ("Combined Sobel", combined))
